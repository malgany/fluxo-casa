{
  "name": "fluxo-casa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host ::",
    "serve:app": "tsx server/app.ts",
    "serve:all": "concurrently -k -n API,APP \"npm:dev:api\" \"npm:serve:app\"",
    "build": "tsc -p tsconfig.node.json && tsc -p tsconfig.app.json && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@vercel/blob": "^2.3.3",
    "dexie": "^4.0.11",
    "dexie-react-hooks": "^1.1.7",
    "fastify": "^5.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.1.0",
    "fake-indexeddb": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.6"
  }
}
